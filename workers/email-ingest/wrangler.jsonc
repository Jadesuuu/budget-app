{
  // Inbound bank emails -> raw_emails. Secrets come from .dev.vars locally and `wrangler secret put` in production.
  "name": "budget-email-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Safety net + keep-alive: re-runs the parse job and touches Supabase (free projects pause after a week idle).
  "triggers": { "crons": ["*/15 * * * *"] }
}
