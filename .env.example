# Local values come from: pnpm exec supabase status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the email parser / cron jobs, never in the browser.
SUPABASE_SECRET_KEY=
# Domain that receives forwarded bank emails (u_xxxxxxxxxx@<this>).
INBOUND_EMAIL_DOMAIN=in.jadebonifacio.dev
# Comma-separated emails allowed to create an account (existing users can always sign in).
ALLOWED_SIGNUP_EMAILS=

# Parse job: shared secret between the email Worker / cron and /api/jobs/parse-emails
PARSE_JOB_SECRET=

# Web push alerts (bills due, over today's amount). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
